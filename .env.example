# ------------------------------------------------------------------
# Copiez ce fichier en ".env" puis complétez les valeurs.
# Sans aucune valeur, le site fonctionne en MODE DÉMO :
#   - base de données locale embarquée (dossier ./data)
#   - paiement simulé (aucun débit réel)
#   - emails et SMS non envoyés mais visibles dans Admin > Emails & SMS
# ------------------------------------------------------------------

# Adresse publique du site (utilisée dans les emails et les retours de paiement)
APP_URL=http://localhost:3000

# Base de données PostgreSQL de production (Supabase, Neon, Scaleway...).
# Laisser vide en local pour utiliser la base embarquée.
DATABASE_URL=

# Paiement Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Emails Resend (https://resend.com) - l'adresse d'expédition doit être sur un domaine vérifié
RESEND_API_KEY=
EMAIL_FROM="Chez Juju <commandes@votre-domaine.fr>"

# SMS Brevo (https://app.brevo.com > SMTP & API > Clés API) – SMS de suivi envoyés en plus des emails
BREVO_API_KEY=
# Nom d'expéditeur des SMS (3 à 11 lettres/chiffres, sans espace). Par défaut : nom du site
SMS_SENDER=

# Secret protégeant la tâche planifiée /api/cron (chaîne aléatoire longue)
CRON_SECRET=

# Compte administrateur créé au premier lancement (npm run db:seed)
SEED_ADMIN_EMAIL=admin@chezjuju.fr
SEED_ADMIN_PASSWORD=ChangezMoi-2026!
